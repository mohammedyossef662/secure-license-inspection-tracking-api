# Production environment for: docker compose -f docker-compose.prod.yml
# Copy this file to .env.production and fill in every "replace-" value.
# Never commit .env.production.

# Public hostname only: no https:// and no trailing slash.
# No domain? Use your VM's public IPv4, for example: 203.0.113.10.sslip.io
# With a domain, point an A record at the VM and use e.g. api.example.com
SITE_ADDRESS=203.0.113.10.sslip.io

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Database credentials (used by both the MySQL container and the API).
MYSQL_DATABASE=license_inspection
MYSQL_USER=appuser
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-app-password

# First boot only: create the demo users. Set to false after the first deploy.
SEED_ON_START=true
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_INSPECTOR_PASSWORD=replace-with-a-strong-inspector-password
SEED_VIEWER_PASSWORD=replace-with-a-strong-viewer-password

# Optional tuning
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
