# Application
APP_NAME=Regulatory License & Inspection Tracking API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=false
LOG_LEVEL=INFO

# Database (MySQL in production; SQLite is used for local unit-test runs)
DATABASE_URL=mysql+pymysql://appuser:momo@127.0.0.1:3306/license_inspection
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800

# Authentication / JWT
SECRET_KEY=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=license-inspection-api
JWT_AUDIENCE=license-inspection-api-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15

# HTTP security
ALLOWED_ORIGINS=
ALLOWED_HOSTS=*
TRUST_PROXY_HEADERS=false
ENABLE_HSTS=false

# Login rate limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IP_MULTIPLIER=5

# Development helpers
SEED_ON_START=false
